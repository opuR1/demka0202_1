<Page x:Class="pr1.Pages.ServiceEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ServiceEdit" Background="{StaticResource MainBk}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1">
            <Image x:Name="imgService" Source="{Binding ImagePath}" Width="100" Height="100"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="5,5,5,0">
                    <TextBlock Text="Название:" Margin="0,0,0,15"/>
                    <TextBlock Text="Стоимость:" Margin="0,0,0,13"/>
                    <TextBlock Text="Длительность(мин):" Margin="0,0,0,13"/>
                    <TextBlock Text="Скидка(%):"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <TextBox x:Name="tbName" Width="200" Margin="0,0,0,10"/>
                    <TextBox x:Name="tbCost" Width="200" Margin="0,0,0,10"/>
                    <TextBox x:Name="tbDuration" Width="200" Margin="0,0,0,10"/>
                    <TextBox x:Name="tbDiscount" Width="200"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="tblError" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0" Height="90"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                <Button Content="Сохранить" x:Name="btnSave" Width="100" Height="50" Background="{StaticResource AccentBk}" FontWeight="Bold" Margin="0,0,10,0" Click="btnSave_Click"/>
                <Button Content="Изменить изображение" x:Name="btnimgEdit" Width="175" Height="50" Background="{StaticResource AccentBk}" FontWeight="Bold" Margin="0,0,10,0" Click="btnimgEdit_Click"/>
                <Button Content="Удалить" x:Name="btnDel" Width="100" Height="50" Background="{StaticResource AccentBk}" FontWeight="Bold" Click="btnDel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
